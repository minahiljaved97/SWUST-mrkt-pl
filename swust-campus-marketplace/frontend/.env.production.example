# Vercel production (no custom API domain yet):
# Browser calls same-origin /api/v1; vercel.json proxies to EC2.
VITE_API_BASE_URL=/api/v1

# Later, when API has HTTPS (domain + Certbot), switch to:
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
# and remove the /api + /media proxy rewrites from vercel.json.
