# Development defaults — copy to `.env` and adjust.
# NEVER commit real secrets. Production values belong in the host/CI secret store.

SECRET_KEY=replace-with-a-long-random-string-at-least-50-characters-long
DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.development

# Local default is SQLite. Production MUST use PostgreSQL (e.g. RDS).
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/swust_marketplace
DATABASE_URL=sqlite:///db.sqlite3

ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# Prefer a dedicated JWT signing key in production (falls back to SECRET_KEY).
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

ALLOWED_EMAIL_DOMAINS=mails.swust.edu.cn,swust.edu.cn
TIME_ZONE=Asia/Shanghai

# ---------------------------------------------------------------------------
# Target production topology
#   Internet → Vercel (React/Vite) → HTTPS → Django on AWS EC2
#                              ├→ PostgreSQL (RDS or EC2-hosted)
#                              └→ Media on S3 / S3-compatible
# ---------------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.production
# DEBUG=false
# SECRET_KEY=<50+ random characters>
# DATABASE_URL=postgres://USER:PASSWORD@RDS_HOST:5432/swust_marketplace
# DATABASE_SSLMODE=require
# ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://app.example.com
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://app.example.com
# SECURE_SSL_REDIRECT=true
# USE_X_FORWARDED_HOST=true
# SECURE_HSTS_SECONDS=31536000
# LOG_LEVEL=INFO
# JWT_SIGNING_KEY=<dedicated random key>
#
# S3 / compatible media (recommended on EC2 — do not store uploads on the instance disk):
# USE_S3_MEDIA=true
# AWS_STORAGE_BUCKET_NAME=your-media-bucket
# AWS_S3_REGION_NAME=ap-northeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_CUSTOM_DOMAIN=cdn.example.com
# AWS_S3_ENDPOINT_URL=
# AWS_MEDIA_LOCATION=media
# AWS_QUERYSTRING_AUTH=false
# SERVE_MEDIA=false
