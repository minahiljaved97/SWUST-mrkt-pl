SECRET_KEY=replace-with-a-long-random-string
DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.development

# Local default is SQLite so the project runs without Docker/Postgres.
# Production MUST use PostgreSQL, for example:
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/swust_marketplace
DATABASE_URL=sqlite:///db.sqlite3

ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

ALLOWED_EMAIL_DOMAINS=mails.swust.edu.cn,swust.edu.cn
TIME_ZONE=Asia/Shanghai
