# Copy to `.env.docker` for `docker compose --env-file .env.docker up --build`.
# Placeholders only — never commit real credentials.

POSTGRES_DB=swust_marketplace
POSTGRES_USER=swust
POSTGRES_PASSWORD=replace-with-a-strong-db-password

SECRET_KEY=replace-with-a-long-random-string-at-least-50-characters-long-xx
DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings.production

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=true

# Local compose usually terminates HTTP at nginx without TLS.
SECURE_SSL_REDIRECT=false
USE_X_FORWARDED_HOST=true
SERVE_MEDIA=true
LOG_LEVEL=INFO

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
ALLOWED_EMAIL_DOMAINS=
TIME_ZONE=Asia/Shanghai

# Browser-facing API URL baked into the SPA at image build time.
# Same-origin path works with the bundled nginx reverse proxy:
VITE_API_BASE_URL=/api/v1
WEB_PORT=8080
