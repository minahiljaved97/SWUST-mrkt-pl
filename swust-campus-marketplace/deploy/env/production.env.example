# Production environment for EC2 — copy to /etc/swust-api/env (mode 600).
# NEVER commit this file with real values.

DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-string-at-least-50-characters-long
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
CORS_ALLOW_CREDENTIALS=true

# PostgreSQL — use Supabase (free) or Amazon RDS
# Supabase: Project Settings → Database → Connection string (URI)
# Prefer Session mode / direct host for Django migrations.
DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSLMODE=require

SECURE_SSL_REDIRECT=true
USE_X_FORWARDED_HOST=true
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

JWT_SIGNING_KEY=replace-with-a-dedicated-random-jwt-signing-key
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
ALLOWED_EMAIL_DOMAINS=mails.swust.edu.cn,swust.edu.cn
TIME_ZONE=Asia/Shanghai

# Media — free options:
# A) Supabase Storage (S3-compatible) — set USE_S3_MEDIA=true + endpoint
# B) AWS S3 free-tier / R2
# C) Local EC2 disk for demos only (USE_S3_MEDIA=false, SERVE_MEDIA=true)
USE_S3_MEDIA=false
SERVE_MEDIA=true
# AWS_STORAGE_BUCKET_NAME=your-media-bucket
# AWS_S3_REGION_NAME=ap-northeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
# AWS_MEDIA_LOCATION=media
# AWS_QUERYSTRING_AUTH=false

GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
